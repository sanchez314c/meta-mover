root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.{js,jsx}]
indent_size = 2

[*.{ts,tsx}]
indent_size = 2

[*.html]
indent_size = 2

[*.css]
indent_size = 2

[*.py]
indent_size = 4

[Makefile]
indent_style = tab