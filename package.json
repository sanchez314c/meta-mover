{
  "name": "meta-mover",
  "version": "1.0.0",
  "description": "Professional Media Organization Suite - Complete Multi-Platform Build System",
  "desktopName": "com.speedheathens.metamover",
  "main": "dist/main/index.js",
  "homepage": "https://github.com/sanchez314c/meta-mover#readme",
  "author": {
    "name": "J. Michaels",
    "email": "sanchez314c@speedheathens.com",
    "url": "https://github.com/sanchez314c"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanchez314c/meta-mover.git"
  },
  "bugs": {
    "url": "https://github.com/sanchez314c/meta-mover/issues"
  },
  "keywords": [
    "electron",
    "media",
    "organization",
    "photo",
    "video",
    "metadata",
    "desktop",
    "cross-platform",
    "typescript",
    "react"
  ],
  "scripts": {
    "dev": "npm run package:stage-tools && npm run build:dev && electron . --dev",
    "start": "electron .",
    "start:prod": "NODE_ENV=production electron .",
    "build": "npm run clean:dist && npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "webpack --config config/webpack.main.config.js --mode production",
    "build:preload": "webpack --config config/webpack.preload.config.js --mode production",
    "build:renderer": "webpack --config config/webpack.renderer.config.js --mode production",
    "build:dev": "npm run clean:dist && npm run build:main:dev && npm run build:preload:dev && npm run build:renderer:dev",
    "build:main:dev": "webpack --config config/webpack.main.config.js --mode development",
    "build:preload:dev": "webpack --config config/webpack.preload.config.js --mode development",
    "build:renderer:dev": "webpack --config config/webpack.renderer.config.js --mode development",
    "watch": "npm run build:dev && concurrently \"npm run watch:main\" \"npm run watch:renderer\" \"wait-on dist/main/index.js dist/renderer/index.html && electron .\"",
    "watch:main": "webpack --config config/webpack.main.config.js --mode development --watch",
    "watch:preload": "webpack --config config/webpack.preload.config.js --mode development --watch",
    "watch:renderer": "webpack --config config/webpack.renderer.config.js --mode development --watch",
    "clean": "npm run clean:dist && npm run clean:release && npm run clean:temp",
    "clean:dist": "rimraf dist",
    "clean:release": "rimraf release",
    "clean:temp": "rimraf temp && rimraf *.log && rimraf npm-debug.log*",
    "clean:all": "npm run clean && rimraf node_modules && rimraf package-lock.json",
    "pack": "npm run build && electron-builder --dir",
    "pack:linux": "npm run build && electron-builder --linux --dir",
    "dist:linux:deb": "npm run build && electron-builder --linux deb --x64",
    "dist:linux:rpm": "npm run build && electron-builder --linux rpm --x64",
    "prepack": "npm run build",
    "predist": "npm run build",
    "lint": "eslint src --ext .ts,.tsx --fix",
    "lint:check": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "jest --config config/jest.config.js",
    "test:watch": "jest --config config/jest.config.js --watch",
    "test:coverage": "jest --config config/jest.config.js --coverage",
    "test:ci": "npm run package:stage-tools && jest --config config/jest.config.js --ci --coverage --watchAll=false",
    "package:stage-tools": "node scripts/stage-bundled-tools.js",
    "package:build-portable-perl": "node scripts/build-portable-perl.js",
    "native:build": "node scripts/build-launch-broker.js",
    "native:broker:build": "node scripts/build-launch-broker.js",
    "native:verify": "cargo fmt --manifest-path native/fs-helper/Cargo.toml -- --check && cargo clippy --manifest-path native/fs-helper/Cargo.toml --locked --all-targets -- -D warnings && cargo test --manifest-path native/fs-helper/Cargo.toml --locked && cargo fmt --manifest-path native/launch-broker/Cargo.toml -- --check && cargo clippy --manifest-path native/launch-broker/Cargo.toml --locked --all-targets -- -D warnings && cargo test --manifest-path native/launch-broker/Cargo.toml --locked",
    "package:integrity:source": "node scripts/verify-package-integrity.js --source src/main --config config",
    "package:integrity": "npm run package:stage-tools && node scripts/verify-package-integrity.js --source src/main --config config --dist dist/main --resources .build-tools/tools",
    "package:integrity:release": "node scripts/verify-package-integrity.js --packaged-release release",
    "verify": "npm run format:check && npm run lint:check && npm run typecheck && npm run native:verify && npm run package:integrity:source && npm run test:ci",
    "security:audit": "npm audit",
    "security:audit:fix": "npm audit fix"
  },
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "^20.11.30",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "concurrently": "^8.2.2",
    "css-loader": "^7.1.2",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.3.2",
    "jest": "30.5.0",
    "jest-environment-jsdom": "30.5.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "style-loader": "^4.0.0",
    "styled-components": "6.5.3",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "ts-loader": "^9.5.0",
    "typescript": "^5.2.2",
    "wait-on": "9.1.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "exiftool-vendored": "37.2.0",
    "winston": "3.19.0",
    "@reduxjs/toolkit": "^2.8.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-redux": "^9.2.0"
  },
  "dependencies": {},
  "build": {
    "appId": "com.speedheathens.metamover",
    "productName": "META Mover",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "copyright": "Copyright © 2025 SpeedHeathens",
    "buildVersion": "1.0.0.${env.BUILD_NUMBER}",
    "compression": "maximum",
    "asar": true,
    "npmRebuild": false,
    "forceCodeSigning": true,
    "beforePack": "scripts/stage-bundled-tools.js",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "extraMetadata": {
      "name": "META Mover",
      "main": "dist/main/index.js"
    },
    "files": [
      "dist/**/*",
      "!**/*.py",
      "!**/*.pyc",
      "!**/*.pyo",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,__pycache__,thumbs.db,.gitignore,.gitattributes,.editorconfig,*.swp,*.tmp,*.log}"
    ],
    "extraResources": [
      {
        "from": ".build-tools/tools",
        "to": "tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": null,
    "mac": {
      "category": "public.app-category.photography",
      "icon": "resources/icons/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "darkModeSupport": true,
      "minimumSystemVersion": "10.15.0",
      "target": [
        {
          "target": "pkg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "CFBundleDisplayName": "META Mover",
        "CFBundleExecutable": "META Mover",
        "CFBundleIdentifier": "com.speedheathens.metamover",
        "CFBundleShortVersionString": "1.0.0",
        "CFBundleVersion": "1.0.0",
        "LSMinimumSystemVersion": "10.15.0",
        "NSCameraUsageDescription": "META Mover needs camera access to organize camera media files.",
        "NSMicrophoneUsageDescription": "META Mover needs microphone access to process audio metadata.",
        "NSPhotoLibraryUsageDescription": "META Mover needs photo library access to organize your photos."
      }
    },
    "pkg": {
      "license": "resources/license.txt",
      "allowAnywhere": false,
      "allowCurrentUserHome": false,
      "allowRootDirectory": true,
      "installLocation": "/Applications"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icons/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": true,
      "signExecutable": true,
      "signExts": [
        ".dll"
      ],
      "verifyUpdateCodeSignature": true,
      "signtoolOptions": {
        "publisherName": "SpeedHeathens",
        "rfc3161TimeStampServer": "https://timestamp.digicert.com",
        "timeStampServer": "https://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "META Mover",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "license": "resources/license.txt",
      "warningsAsErrors": true,
      "displayLanguageSelector": false,
      "multiLanguageInstaller": false,
      "packElevateHelper": true,
      "menuCategory": "Photography"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons",
      "category": "Photography",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "META Mover",
          "Comment": "Professional Media Organization Suite",
          "GenericName": "Media Organizer",
          "Keywords": "photo;video;media;organize;metadata;exif;",
          "StartupWMClass": "com.speedheathens.metamover",
          "MimeType": "image/jpeg;image/png;image/tiff;video/mp4;video/mov;"
        }
      },
      "synopsis": "Professional Media Organization Suite",
      "description": "META Mover v1.0 organizes photo and video collections using provenance-aware metadata handling.",
      "maintainer": "sanchez314c <sanchez314c@speedheathens.com>"
    },
    "deb": {
      "packageName": "meta-mover",
      "priority": "optional",
      "compression": "xz"
    },
    "rpm": {
      "packageName": "meta-mover",
      "compression": "xz"
    },
    "protocols": [
      {
        "name": "META Mover Protocol",
        "role": "Editor",
        "schemes": [
          "metamover"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "jpg",
        "name": "JPEG Image",
        "description": "JPEG Image File",
        "mimeType": "image/jpeg",
        "role": "Viewer"
      },
      {
        "ext": "png",
        "name": "PNG Image",
        "description": "PNG Image File",
        "mimeType": "image/png",
        "role": "Viewer"
      },
      {
        "ext": "tiff",
        "name": "TIFF Image",
        "description": "TIFF Image File",
        "mimeType": "image/tiff",
        "role": "Viewer"
      },
      {
        "ext": "mp4",
        "name": "MP4 Video",
        "description": "MP4 Video File",
        "mimeType": "video/mp4",
        "role": "Viewer"
      },
      {
        "ext": "mov",
        "name": "QuickTime Video",
        "description": "QuickTime Video File",
        "mimeType": "video/quicktime",
        "role": "Viewer"
      }
    ]
  },
  "eslintConfig": {
    "extends": [
      "plugin:@typescript-eslint/recommended",
      "plugin:react/recommended",
      "plugin:react-hooks/recommended",
      "plugin:jsx-a11y/recommended",
      "prettier"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint",
      "react",
      "react-hooks",
      "jsx-a11y",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": "error",
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "varsIgnorePattern": "^_",
          "argsIgnorePattern": "^_",
          "caughtErrorsIgnorePattern": "^_"
        }
      ],
      "react/react-in-jsx-scope": "off"
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false
  },
  "browserslist": {
    "production": [
      "chrome >= 87",
      "node >= 14"
    ],
    "development": [
      "chrome >= 87",
      "node >= 14"
    ]
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "overrides": {
    "handlebars": "4.7.9",
    "shell-quote": "1.10.0",
    "websocket-driver": "0.7.5"
  },
  "packageManager": "npm@10.9.0"
}
